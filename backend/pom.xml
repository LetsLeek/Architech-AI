<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ai.architech</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Architech AI Platform Backend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!--
			AIW-94: overrides spring-boot-starter-parent's managed 11.0.24, which carries
			CVE-2026-65182/65905/68525 (all CRITICAL) - bumped ahead of Spring Boot's own next
			release since Trivy's dependency scan gate needs a real CVE-free baseline to start
			from. Safe to remove once a spring-boot-starter-parent release manages >= 11.0.25
			itself.
		-->
		<tomcat.version>11.0.25</tomcat.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<!-- `testcontainers.version` is already defined by spring-boot-starter-parent; this just imports the matching BOM. -->
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>2.0.5</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
		</dependency>
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>3.0.7</version>
		</dependency>
		<dependency>
			<!--
				AIW-143 (gates 7-12): drives a real headless Chromium directly from this JVM to
				smoke-check a Developer execution's own generated site - self-contained (no Node/
				npx step needed the way e2e/'s own Node-based Playwright config requires), matching
				this backend's own Java-native tooling elsewhere. Browser binaries are a separate,
				one-time install (`mvn -q exec:java -e -Dexec.mainClass=com.microsoft.playwright.CLI
				-Dexec.args=install`), not managed by Maven itself - see
				backend-ci.yml's own install step for the CI-side equivalent.
			-->
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>1.62.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!--
				AIW-91: `src/test/resources/application.yml` points the datasource at a
				`jdbc:tc:postgresql:...` URL - this module's `ContainerDatabaseDriver`
				intercepts that URL and transparently backs it with a disposable Testcontainers
				Postgres, so integration tests need neither a manually-started `docker compose`
				Postgres nor any Java-side container wiring.
			-->
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Provides the actual Postgres container definition the `tc:postgresql:` URL prefix resolves to. -->
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!--
					AIW-91: unit tests (Surefire, `*Tests.java`) and integration tests against a
					real disposable Postgres (Failsafe, `*IT.java`) now run as two separate,
					separately-reported phases instead of one combined `test` run - see the
					surefire/failsafe plugin configs below. Both agents write into the *same*
					jacoco.exec (the integration one with append=true) so `report`/`check` below
					still see combined coverage, matching the baseline AIW-90 originally locked
					in across what was then one undifferentiated test run.
				-->
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<configuration>
							<propertyName>surefireArgLine</propertyName>
						</configuration>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-integration</id>
						<phase>pre-integration-test</phase>
						<configuration>
							<propertyName>failsafeArgLine</propertyName>
							<destFile>${project.build.directory}/jacoco.exec</destFile>
							<append>true</append>
						</configuration>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<!--
								Floor locked to the first real measurement (see
								docs/operations/ci-quality-gate-policy.md's coverage ratchet
								strategy) - raise these as coverage grows, never lower them.
							-->
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.93</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
							<excludes>
								<!-- trivial `SpringApplication.run(...)` bootstrap, no branching logic -->
								<exclude>ai/architech/backend/BackendApplication.class</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{surefireArgLine}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<!--
					AIW-91: runs `*IT.java` (Failsafe's default include pattern) - the 31
					@SpringBootTest classes against the real, disposable Testcontainers Postgres
					configured in src/test/resources/application.yml - separately from the plain
					`*Tests.java` unit tests Surefire runs in the `test` phase, so CI output keeps
					them distinguishable (separate plugin executions/log sections) per AIW-91's AC.
					`integration-test`+`verify` are both bound so a failing IT still fails the
					build even though `integration-test` alone doesn't (Failsafe's usual pattern).
				-->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<argLine>@{failsafeArgLine}</argLine>
					<!-- Activates src/test/resources/application-test.yml (Testcontainers datasource), merged on top of the base application.yml. -->
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!--
					project-types/ holds the frozen, project-type-specific agent/rule/skill
					definitions (see repo root README). They live outside backend/ since they are
					not Java and not backend-specific - copying them onto the classpath here lets
					Core load them the same way regardless of working directory or how the app is
					packaged/run.
				-->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-project-type-definitions</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/project-types</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/../project-types</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
