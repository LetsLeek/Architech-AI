# Copy this file to .env and adjust values for your local setup.
# .env is git-ignored - never commit real secrets.

# --- PostgreSQL (used by docker-compose.yml and the backend datasource) ---
POSTGRES_DB=architech
POSTGRES_USER=architech
POSTGRES_PASSWORD=architech
POSTGRES_PORT=5432

# --- Backend datasource (defaults match the docker-compose Postgres above) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/architech
SPRING_DATASOURCE_USERNAME=architech
SPRING_DATASOURCE_PASSWORD=architech

# --- AI provider credentials ---
# Get a key from https://console.anthropic.com (Settings -> API Keys) - this is separate
# from a Claude Pro subscription, with its own billing.
ANTHROPIC_API_KEY=

# OpenAI Provider Adapter (AIW-62) - registered like any other AiProvider bean, but no model
# profile names "openai" by default (see application.yml). Setting this key alone does not
# make anything call OpenAI; get a key from https://platform.openai.com/api-keys if you do
# want to wire a model profile at it yourself.
OPENAI_API_KEY=

# The mock provider (no real AI) is used by default even with a key set above - real AI is
# an explicit opt-in via this profile, so a fresh clone/CI never accidentally calls a paid
# API. To actually use Anthropic locally, also set:
# SPRING_PROFILES_ACTIVE=real-ai
