{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiw:schema:documentation:integration-reference-report:v1",
  "title": "Authorized integration references without secret data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidateRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!latest$)(?!current$)(?!HEAD$)[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contractRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!latest$)(?!current$)(?!HEAD$)[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
          },
          "bindingFunctionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?!latest$)(?!current$)(?!HEAD$)[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
            },
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "credentialDependency": {
            "type": "string",
            "enum": [
              "NONE",
              "SECRET_MANAGED",
              "UNSPECIFIED"
            ]
          }
        },
        "required": [
          "contractRef",
          "bindingFunctionIds",
          "purpose",
          "credentialDependency"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "candidateRef",
    "integrations"
  ]
}
