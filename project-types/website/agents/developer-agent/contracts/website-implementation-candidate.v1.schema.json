{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiw:schema:website-implementation-candidate:v1",
  "title": "WebsiteImplementationCandidatePayload V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceDesign",
    "runtimeProfileRef",
    "repositoryStateRef",
    "implementationSummary",
    "implementationAnchors",
    "functionalBindings",
    "unresolvedIssues"
  ],
  "properties": {
    "sourceDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designArtifactVersionRef",
        "proposalLocalRef"
      ],
      "properties": {
        "designArtifactVersionRef": {
          "$ref": "urn:aiw:schema:developer-common:v1#/$defs/OpaqueRef"
        },
        "proposalLocalRef": {
          "$ref": "urn:aiw:schema:developer-common:v1#/$defs/OpaqueRef"
        }
      }
    },
    "runtimeProfileRef": {
      "$ref": "urn:aiw:schema:developer-common:v1#/$defs/OpaqueRef"
    },
    "repositoryStateRef": {
      "$ref": "urn:aiw:schema:developer-common:v1#/$defs/OpaqueRef"
    },
    "implementationSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "implementationAnchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "urn:aiw:schema:implementation-anchor:v1"
      }
    },
    "functionalBindings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "urn:aiw:schema:functional-binding:v1"
      }
    },
    "unresolvedIssues": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:aiw:schema:unresolved-issue:v1"
      }
    }
  }
}
