{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiw:schema:implementation-anchor:v1",
  "title": "ImplementationAnchor V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "designLocalRef",
    "kind",
    "targets"
  ],
  "properties": {
    "designLocalRef": {
      "$ref": "urn:aiw:schema:developer-common:v1#/$defs/OpaqueRef"
    },
    "kind": {
      "enum": [
        "PAGE",
        "SECTION",
        "ELEMENT",
        "UI_PATTERN"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "$ref": "urn:aiw:schema:developer-common:v1#/$defs/RepositoryRelativePath"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
