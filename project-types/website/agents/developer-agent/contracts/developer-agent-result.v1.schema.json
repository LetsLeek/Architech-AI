{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiw:schema:developer-agent-result:v1",
  "title": "DeveloperAgentResult V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultType",
        "targetDesign",
        "implementationSummary",
        "implementationAnchors",
        "functionalBindings",
        "unresolvedIssues"
      ],
      "properties": {
        "resultType": {
          "const": "IMPLEMENTATION_READY"
        },
        "targetDesign": {
          "$ref": "urn:aiw:schema:developer-common:v1#/$defs/ResultTargetDesign"
        },
        "implementationSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "implementationAnchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "urn:aiw:schema:implementation-anchor:v1"
          }
        },
        "functionalBindings": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "urn:aiw:schema:functional-binding:v1"
          }
        },
        "unresolvedIssues": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:aiw:schema:unresolved-issue:v1"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultType",
        "targetDesign",
        "blockers"
      ],
      "properties": {
        "resultType": {
          "const": "BLOCKED"
        },
        "targetDesign": {
          "$ref": "urn:aiw:schema:developer-common:v1#/$defs/ResultTargetDesign"
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:aiw:schema:developer-blocker:v1"
          }
        }
      }
    }
  ]
}
