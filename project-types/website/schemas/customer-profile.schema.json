{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customer-profile.schema.json",
  "title": "Customer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business",
    "contact",
    "locations",
    "offerings",
    "openingHours",
    "socialLinks",
    "providedClaims",
    "unknowns",
    "conflicts",
    "provenance"
  ],
  "properties": {
    "business": {
      "$ref": "#/$defs/business"
    },
    "contact": {
      "$ref": "#/$defs/contact"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "offerings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offering"
      }
    },
    "openingHours": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openingHoursSet"
      }
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/socialLink"
      }
    },
    "providedClaims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providedClaim"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "localRef": {
      "type": "string",
      "minLength": 1
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "street": {
          "type": "string",
          "minLength": 1
        },
        "postalCode": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "raw": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "street"
          ]
        },
        {
          "required": [
            "postalCode"
          ]
        },
        {
          "required": [
            "city"
          ]
        },
        {
          "required": [
            "countryCode"
          ]
        },
        {
          "required": [
            "raw"
          ]
        }
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "raw"
      ],
      "properties": {
        "type": {
          "enum": [
            "fixed",
            "from",
            "range",
            "on-request",
            "other"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "maxAmount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "raw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "$ref": "#/$defs/price"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "category"
          ]
        },
        {
          "required": [
            "price"
          ]
        }
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        },
        "to": {
          "type": "string",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
        }
      }
    },
    "scheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "intervals"
      ],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MO",
              "TU",
              "WE",
              "TH",
              "FR",
              "SA",
              "SU"
            ]
          }
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interval"
          }
        }
      }
    },
    "openingHoursSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef",
        "raw"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "locationRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localRef"
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduleEntry"
          }
        },
        "closedDays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "MO",
              "TU",
              "WE",
              "TH",
              "FR",
              "SA",
              "SU"
            ]
          }
        },
        "raw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "socialLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "url",
        "sourceRefs"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "providedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "sourceRefs"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing",
            "ambiguous"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "conflictStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "sourceRefs"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "description",
        "statements"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "statements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/conflictStatement"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRefs"
      ],
      "properties": {
        "targetRef": {
          "$ref": "#/$defs/localRef"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "anyOf": [
        {
          "required": [
            "targetRef"
          ]
        },
        {
          "required": [
            "field"
          ]
        }
      ]
    }
  }
}
