{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-requirements.schema.json",
  "title": "Website Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goals",
    "targetAudiences",
    "contentRequirements",
    "functionalRequirements",
    "languages",
    "constraints",
    "unknowns",
    "conflicts"
  ],
  "properties": {
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "targetAudiences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audience"
      }
    },
    "contentRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentRequirement"
      }
    },
    "functionalRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/functionalRequirement"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "localRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strength": {
      "enum": [
        "must",
        "should",
        "could"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef",
        "description",
        "strength",
        "sourceRefs"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef",
        "description",
        "sourceRefs"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "contentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef",
        "type",
        "description",
        "strength",
        "sourceRefs"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "type": {
          "enum": [
            "business-description",
            "contact-information",
            "location",
            "opening-hours",
            "offering",
            "pricing",
            "gallery",
            "team",
            "testimonials",
            "legal-information",
            "custom"
          ]
        },
        "customType": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "functionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef",
        "type",
        "description",
        "strength",
        "sourceRefs"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "type": {
          "enum": [
            "contact-form",
            "map",
            "booking",
            "newsletter",
            "search",
            "download",
            "custom"
          ]
        },
        "customType": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "strength",
        "sourceRefs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localRef",
        "category",
        "description",
        "strength",
        "sourceRefs"
      ],
      "properties": {
        "localRef": {
          "$ref": "#/$defs/localRef"
        },
        "category": {
          "enum": [
            "navigation",
            "design",
            "content",
            "business",
            "integration",
            "technical"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing",
            "ambiguous"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "affects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localRef"
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "anyOf": [
        {
          "required": [
            "field"
          ]
        },
        {
          "required": [
            "affects"
          ]
        }
      ]
    },
    "conflictStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "sourceRefs"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "statements"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "affects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localRef"
          }
        },
        "statements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/conflictStatement"
          }
        }
      }
    }
  }
}
