{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue"
    ],
    "deny": [
      "Bash(git push * -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -f *)",
      "Bash(git checkout --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-destructive-git.sh"
          }
        ]
      }
    ]
  }
}
